{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-flash",
  "agents": {
    "title": {
      "model": "deepseek/deepseek-flash"
    }
  },
  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash"
        }
      }
    }
  }
}
